# ============================================================
# Nexora CRM — Environment Configuration Template
# Copy this file to .env and configure your production credentials
# ============================================================

# Application Environment
NODE_ENV=production
PORT=3001

# Authentication & Security
# IMPORTANT: Generate a strong, random 64-character secret for production
# Example: openssl rand -base64 48
JWT_SECRET=nexora-enterprise-production-super-secret-key-change-me-immediately-in-prod
JWT_EXPIRES_IN=7d

# Database Configuration
# MongoDB connection URI (optional - app automatically falls back to in-memory store if unset)
MONGODB_URI=mongodb://mongo:27017/nexora_crm

# Client & CORS
# Allowed client origin URL (e.g., https://crm.yourdomain.com)
CLIENT_ORIGIN=http://localhost:3001

# Rate Limiting (Optional overrides)
AUTH_RATE_LIMIT=100
API_RATE_LIMIT=2000

